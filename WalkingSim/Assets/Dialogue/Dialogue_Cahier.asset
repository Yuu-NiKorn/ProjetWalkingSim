  m_Name: Dialogue_Cahier
  m_EditorClassIdentifier: 
  lines:
  - text: "\xC0 qui appartient ce cahier."
    audio: {fileID: 0}
    duration: 3
  - text: 'Ange : tu te souvient vraiment pas ?'
    audio: {fileID: 0}
    duration: 3
  - text: "Non, mais si je me souvient pas c'est que sa doit pas \xEAtre important."
    audio: {fileID: 0}
    duration: 3
  - text: 'Ange : ...'
    audio: {fileID: 0}
    duration: 3
  - text: 'Ange : C''est le carnet de Jean Jacque.'
    audio: {fileID: 0}
    duration: 3
  - text: Jean Jacque ? Se type qui me suit partout.
    audio: {fileID: 0}
    duration: 3
  - text: Pourquoi je voit son carnet dans mes souvenir ?
    audio: {fileID: 0}
    duration: 3
