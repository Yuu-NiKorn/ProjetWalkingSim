  m_Name: Dialogue_Cahier
  m_EditorClassIdentifier: 
  lines:
  - text: "Mais \xE0 qui peut bien appartenir ce cahier ?"
    audio: {fileID: 0}
    duration: 2
  - text: "\u202F\" Et pourtant Malcom et Jean Jacque ont disparu dans le b\xE2timent,
      peut-\xEAtre qu\u2019ils ont trouv\xE9 quelque chose ? Mais pourquoi ont-ils
      ferm\xE9 la porte ? \" "
    audio: {fileID: 0}
    duration: 3
  - text: '"Trop bizarre" '
    audio: {fileID: 0}
    duration: 2
  - text: '"Trop bizarre" '
    audio: {fileID: 0}
    duration: 2
  - text: "Mais \xE7a parle de moi !!!"
    audio: {fileID: 0}
    duration: 2
  - text: "Si j\u2019ai v\xE9cu et vu tout \xE7a\u2026 Cette note\u2026  Cet endroit\u2026
      C\u2019est un r\xEAve nan ? "
    audio: {fileID: 0}
    duration: 2
