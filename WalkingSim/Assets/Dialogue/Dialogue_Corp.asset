  m_Script: {fileID: 11500000, guid: 6ace8cb2c0b5f5f4eae8d3c88b669c6a, type: 3}
  m_Name: Dialogue_Corp
  m_EditorClassIdentifier: 
  lines:
  - text: "Malcom\u202F: Un drap avec des taches de sang ? "
    audio: {fileID: 0}
    duration: 3
  - text: "Malcom\u202F: C\u2019est... Moi... ? J-je... suis mort ? C\u2019est...
      Cette espace... Ces salles... L\u2019Entre-Deux ? "
    audio: {fileID: 0}
    duration: 5
  - text: "Ange\u202F: En effet... Et v\xF4tre jugement n'attend que vous "
    audio: {fileID: 0}
    duration: 3
  - text: "Malcom\u202F: Mais qui \xEAtes-vous ? "
    audio: {fileID: 0}
    duration: 3
  - text: "Ange\u202F: Votre gardien... Laissez-moi vous mener vers votre finalit\xE9 "
    audio: {fileID: 0}
    duration: 5
