  m_Script: {fileID: 11500000, guid: 6ace8cb2c0b5f5f4eae8d3c88b669c6a, type: 3}
  m_Name: Dialogue_Bordelele
  m_EditorClassIdentifier: 
  lines:
  - text: Un caillou...
    audio: {fileID: 0}
    duration: 3
  - text: "Ange : C'est celui que tu utiliser pour maltrait\xE9 mes autres."
    audio: {fileID: 0}
    duration: 3
  - text: "Roh ! \xE7a va ! c'\xE9tait pour rire, rien de bien m\xE9chant."
    audio: {fileID: 0}
    duration: 3
  - text: 'Ange : Tu lance des caillous sur tes amies toi ?'
    audio: {fileID: 0}
    duration: 3
  - text: "Ange : Comment tu r\xE9agiras si on te lance des cailloux."
    audio: {fileID: 0}
    duration: 3
  - text: "Je m'\xE9nerverais !"
    audio: {fileID: 0}
    duration: 3
  - text: 'Ange : Voila.'
    audio: {fileID: 0}
    duration: 3
